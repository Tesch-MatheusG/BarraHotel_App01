@startuml Login
actor Usuário
participant "LoginPage" as LP
participant "LoginViewModel" as LVM
participant "Firebase Auth" as FA
participant "Firestore" as FS
participant "UsuarioMockStore" as UMS
participant "Sessao" as S

Usuário -> LP: Informa email e senha
LP -> LVM: login(email, senha)
LVM -> FA: signInWithEmailAndPassword()

alt Firebase autentica com sucesso
    FA --> LVM: UserCredential
    LVM -> FS: buscar dados do usuário (uid)
    FS --> LVM: dados do usuário

    alt Dados encontrados no Firestore
        LVM --> LP: Efetua login
    else Dados não encontrados
        LVM --> LP: Comunica e-mail não cadastrado e solicita cadastro
    end

    LP -> S: iniciar(usuario)

    alt Perfil é ADM ou Master
        LP --> Usuário: Redireciona para Painel ADM
    else Perfil é Cliente
        LP --> Usuário: Redireciona para Home
    end

else Firebase falha
    LVM -> UMS: autenticar(email, senha)

    alt Encontrado no mock (ADM Master)
        UMS --> LVM: UsuarioModel
        LVM --> LP: UsuarioModel
        LP -> S: iniciar(usuario)
        LP --> Usuário: Redireciona para Painel ADM
    else Não encontrado
        UMS --> LVM: null
        LVM --> LP: null
        LP --> Usuário: Exibe mensagem de erro

        opt 5 tentativas consecutivas
            LP --> Usuário: Conta bloqueada por 15 minutos
        end
    end
end
@enduml