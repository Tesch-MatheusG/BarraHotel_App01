@startuml Cadastro
actor Usuário
participant "SignupPage" as SP
participant "SignupViewModel" as SVM
participant "Firebase Auth" as FA
participant "Firestore" as FS

Usuário -> SP: Preenche formulário de cadastro
SP -> SP: Valida campos obrigatórios

alt Campos válidos
    SP -> SVM: cadastrar(dados)
    SVM -> FA: createUserWithEmailAndPassword()

    alt Cadastro bem-sucedido
        FA --> SVM: UserCredential
        SVM -> FS: salvar dados extras\n(nome, cpf, telefone, cep, endereco)
        FS --> SVM: OK
        SVM --> SP: true
        SP --> Usuário: Cadastro concluído
        SP --> Usuário: Redireciona para Login
    else Email já cadastrado ou senha fraca
        FA --> SVM: Exception
        SVM --> SP: false
        SP --> Usuário: Exibe mensagem de erro
    end

else Campos inválidos
    SP --> Usuário: Destaca campos obrigatórios
end
@enduml