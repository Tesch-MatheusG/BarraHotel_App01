@startuml AtividadeLogin
start

:Usuário acessa tela de login;
:Preenche email e senha;

if (Campos válidos?) then (não)
  :Exibe erro de validação;
  stop
else (sim)
  :Envia credenciais ao Firebase Auth;

  if (Firebase autentica?) then (sim)
    :Busca dados completos no Firestore;

    if (Dados encontrados?) then (sim)
      :Efetua o Login;
    else (não)
      :Comunica e-mail não cadastrado e solicita cadastro;
    endif

  else (não)
    :Tenta autenticar no mock local;

    if (Encontrado no mock?) then (sim)
      :Autentica como ADM Master;
    else (não)
      :Exibe mensagem de erro;
      stop
    endif
  endif

  :Inicia sessão com usuário;

  if (Perfil é ADM ou Master?) then (sim)
    :Redireciona para Painel ADM;
  else (não)
    :Redireciona para Home;
  endif
end
@enduml